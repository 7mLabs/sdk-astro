<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/bindings/dotnet</PathMap>
    <PackageId>SevenMLabs.Astrology</PackageId>
    <Version>1.0.1</Version>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/7mLabs/sdk-astro</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://7mlabs.com/astro/</PackageProjectUrl>
    <Description>7mlabs Astro SDK: offline astrology calculations, IANA birth-time conversion and modular SVG charts.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <None Include="NOTICE" Pack="true" PackagePath="/" />
    <None Include="third-party/*" Pack="true" PackagePath="third-party/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="native/**/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)native/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
