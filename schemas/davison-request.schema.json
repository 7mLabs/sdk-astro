{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:7mlabs:astrology:davison-request:1.0",
  "title": "Davison relationship chart",
  "description": "Arithmetic latitude/longitude means and UT1 time midpoint. corrected adjusts time to the nearest shortest-arc midpoint MC. Runtime enforces valid dates, unique non-antipodal target and convergence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "personA",
    "personB"
  ],
  "properties": {
    "operation": {
      "const": "davison"
    },
    "personA": {
      "$ref": "#/$defs/birthInput"
    },
    "personB": {
      "$ref": "#/$defs/birthInput"
    },
    "domains": {
      "$ref": "urn:7mlabs:astrology:natal-domains-request:1.0#/properties/domains"
    },
    "customProfiles": {
      "$ref": "urn:7mlabs:astrology:natal-domains-request:1.0#/properties/customProfiles"
    },
    "rulership": {
      "$ref": "urn:7mlabs:astrology:natal-domains-request:1.0#/properties/rulership"
    },
    "aspectPreset": {
      "enum": [
        "major",
        "extended"
      ],
      "default": "extended"
    },
    "aspectRules": {
      "$ref": "urn:7mlabs:astrology:natal-domains-request:1.0#/properties/aspectRules"
    },
    "variant": {
      "enum": [
        "uncorrected",
        "corrected"
      ],
      "default": "uncorrected"
    },
    "houseSystem": {
      "enum": [
        "placidus",
        "wholeSign"
      ],
      "default": "placidus"
    },
    "includeMetadata": {
      "type": "boolean",
      "default": false,
      "description": "Opt into additional calculation metadata; default responses retain the legacy contract."
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "aspectRules",
          "aspectPreset"
        ],
        "type": "object",
        "properties": {
          "aspectRules": {},
          "aspectPreset": {}
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "domains"
        ],
        "properties": {
          "domains": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "customProfiles"
        ],
        "properties": {
          "customProfiles": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "birthInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utc",
        "location"
      ],
      "properties": {
        "utc": {
          "$ref": "urn:7mlabs:astrology:natal-domains-request:1.0#/properties/utc"
        },
        "location": {
          "$ref": "urn:7mlabs:astrology:natal-domains-request:1.0#/properties/location"
        },
        "houseSystem": {
          "$ref": "urn:7mlabs:astrology:natal-domains-request:1.0#/properties/houseSystem"
        }
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "houseMethod": {
          "enum": [
            "midpoint",
            "wholeSignFromMidpointAscendant"
          ],
          "default": "midpoint"
        },
        "antipodalPolicy": {
          "enum": [
            "error",
            "lowerLongitude"
          ],
          "default": "error"
        },
        "domains": {
          "$ref": "urn:7mlabs:astrology:natal-domains-request:1.0#/properties/domains"
        },
        "customProfiles": {
          "$ref": "urn:7mlabs:astrology:natal-domains-request:1.0#/properties/customProfiles"
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "domains"
            ],
            "properties": {
              "domains": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "customProfiles"
            ],
            "properties": {
              "customProfiles": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
