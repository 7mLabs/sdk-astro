{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:7mlabs:astrology:render-chart-svg:1.0",
  "title": "Standalone SVG renderer request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "required": [
        "schemaVersion",
        "data",
        "errors"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "data": {
          "type": "object"
        },
        "errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detail": {
          "enum": [
            "basic",
            "advanced",
            "professional",
            null
          ]
        },
        "theme": {
          "enum": [
            "dark",
            "light",
            null
          ]
        },
        "locale": {
          "enum": [
            "vi",
            "en",
            null
          ]
        },
        "orientation": {
          "enum": [
            "ascendant",
            "aries",
            null
          ]
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 128,
          "maximum": 4096
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "instanceId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "chart": {
          "enum": [
            "natal",
            "A",
            "B",
            "C",
            "synastry",
            "transits",
            null
          ]
        },
        "showAspects": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "maxAspectLines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4096
        },
        "aspectAngles": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 32,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          }
        },
        "bodyIds": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "maxItems": 17,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sun",
              "moon",
              "mercury",
              "venus",
              "mars",
              "jupiter",
              "saturn",
              "uranus",
              "neptune",
              "pluto",
              "chiron",
              "trueNorthNode",
              "trueSouthNode",
              "meanNorthNode",
              "meanSouthNode",
              "meanLilith",
              "osculatingLilith"
            ]
          }
        },
        "zodiacSymbols": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aries": {
              "$ref": "#/$defs/symbol"
            },
            "taurus": {
              "$ref": "#/$defs/symbol"
            },
            "gemini": {
              "$ref": "#/$defs/symbol"
            },
            "cancer": {
              "$ref": "#/$defs/symbol"
            },
            "leo": {
              "$ref": "#/$defs/symbol"
            },
            "virgo": {
              "$ref": "#/$defs/symbol"
            },
            "libra": {
              "$ref": "#/$defs/symbol"
            },
            "scorpio": {
              "$ref": "#/$defs/symbol"
            },
            "sagittarius": {
              "$ref": "#/$defs/symbol"
            },
            "capricorn": {
              "$ref": "#/$defs/symbol"
            },
            "aquarius": {
              "$ref": "#/$defs/symbol"
            },
            "pisces": {
              "$ref": "#/$defs/symbol"
            }
          }
        },
        "planetSymbols": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sun": {
              "$ref": "#/$defs/symbol"
            },
            "moon": {
              "$ref": "#/$defs/symbol"
            },
            "mercury": {
              "$ref": "#/$defs/symbol"
            },
            "venus": {
              "$ref": "#/$defs/symbol"
            },
            "mars": {
              "$ref": "#/$defs/symbol"
            },
            "jupiter": {
              "$ref": "#/$defs/symbol"
            },
            "saturn": {
              "$ref": "#/$defs/symbol"
            },
            "uranus": {
              "$ref": "#/$defs/symbol"
            },
            "neptune": {
              "$ref": "#/$defs/symbol"
            },
            "pluto": {
              "$ref": "#/$defs/symbol"
            },
            "chiron": {
              "$ref": "#/$defs/symbol"
            },
            "trueNorthNode": {
              "$ref": "#/$defs/symbol"
            },
            "trueSouthNode": {
              "$ref": "#/$defs/symbol"
            },
            "meanNorthNode": {
              "$ref": "#/$defs/symbol"
            },
            "meanSouthNode": {
              "$ref": "#/$defs/symbol"
            },
            "meanLilith": {
              "$ref": "#/$defs/symbol"
            },
            "osculatingLilith": {
              "$ref": "#/$defs/symbol"
            }
          }
        },
        "aspectColors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "harmonious": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "challenging": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "neutral": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "minor": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "other": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "conjunction": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "sextile": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "square": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "trine": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "opposition": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "semisextile": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "semisquare": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "quintile": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "sesquiquadrate": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "biquintile": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "quincunx": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            }
          },
          "description": "Precedence: type > group > distinct theme default."
        },
        "aspectGroups": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 5,
          "items": {
            "enum": [
              "harmonious",
              "challenging",
              "neutral",
              "minor",
              "other"
            ]
          }
        },
        "maxOrb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 180
        },
        "aspectPhase": {
          "enum": [
            "applying",
            "separating",
            "unknown",
            null
          ]
        },
        "maxAspectRows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4096,
          "default": 256
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "degreeTicks": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "planetDegrees": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "houses": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "angles": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "positionsTable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "housesTable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "aspectTable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "aspectMatrix": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "legend": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "sections": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "wheel",
              "positions",
              "houses",
              "aspectMatrix",
              "aspects",
              "houseFocus"
            ]
          },
          "description": "Ordered independent parts; absent preserves detail preset composition."
        },
        "output": {
          "enum": [
            "svg",
            "model",
            null
          ],
          "description": "model returns geometry, source context and hit targets without generating SVG."
        },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "house": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "layer": {
              "enum": [
                "N",
                "A",
                "B",
                "C"
              ]
            },
            "pointIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 34,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 64
              }
            },
            "mode": {
              "enum": [
                "highlight",
                "isolate"
              ]
            }
          },
          "oneOf": [
            {
              "required": [
                "house"
              ],
              "properties": {
                "house": {}
              },
              "not": {
                "type": "object",
                "required": [
                  "pointIds"
                ],
                "properties": {
                  "pointIds": {}
                }
              }
            },
            {
              "required": [
                "pointIds"
              ],
              "properties": {
                "pointIds": {}
              },
              "not": {
                "type": "object",
                "anyOf": [
                  {
                    "required": [
                      "house"
                    ],
                    "properties": {
                      "house": {}
                    }
                  },
                  {
                    "required": [
                      "layer"
                    ],
                    "properties": {
                      "layer": {}
                    }
                  }
                ]
              }
            }
          ]
        },
        "aspectEndpoints": {
          "enum": [
            "bodies",
            "bodiesAndAngles",
            "all",
            null
          ]
        }
      }
    }
  },
  "$defs": {
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewBox",
        "nodes"
      ],
      "properties": {
        "viewBox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "enum": [
                  "path",
                  "circle",
                  "ellipse",
                  "line",
                  "rect",
                  "polygon",
                  "polyline"
                ]
              },
              {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              }
            ]
          }
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "english": {
          "type": "string",
          "maxLength": 200
        },
        "unicode": {
          "type": "string",
          "maxLength": 200
        },
        "signIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        }
      }
    }
  },
  "$comment": "Runtime validates supported chart adapters, required geometry attributes, full path syntax, finite numbers, fonts, viewBox dimensions and metadata consistency. Max raw input 32 MiB."
}
