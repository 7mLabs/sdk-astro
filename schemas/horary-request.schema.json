{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:7mlabs:astrology:horary-request:1.0",
  "title": "Horary question chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "moment", "quesitedHouse"],
  "if": { "required": ["ruleset"], "properties": { "ruleset": { "const": "lilly-1647-v1" } } },
  "then": { "properties": { "moment": { "type": "object", "properties": { "houseSystem": { "const": "regiomontanus" } } } } },
  "properties": {
    "operation": { "const": "horary" },
    "moment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utc", "location"],
      "properties": {
        "utc": { "$ref": "urn:7mlabs:astrology:natal-request:1.0#/properties/utc" },
        "location": { "$ref": "urn:7mlabs:astrology:natal-request:1.0#/properties/location" },
        "houseSystem": { "$ref": "#/$defs/houseSystem" }
      }
    },
    "quesitedHouse": {
      "description": "House of the matter asked about, selected by the caller.",
      "type": "integer", "minimum": 1, "maximum": 12
    },
    "ruleset": { "enum": ["western-traditional-v1", "lilly-1647-v1"], "default": "western-traditional-v1" }
  },
  "$defs": {
    "houseSystem": { "enum": ["regiomontanus", "placidus", "wholeSign"], "default": "regiomontanus" }
  }
}
